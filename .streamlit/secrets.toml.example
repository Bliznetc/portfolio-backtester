# Copy to .streamlit/secrets.toml (git-ignored) to use Postgres locally.
# On Streamlit Cloud, paste the same line into the app's Settings -> Secrets.
# Without it, the app stores portfolios in a local SQLite file (data/portfolios.db).
#
# Supabase: Connect -> Direct (connection string) -> Method: Session pooler.
# If your password contains special characters (@ : / # ? %), URL-encode them.
DATABASE_URL = "postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
